# Odoo Docker Container Environment Variables
PORT_HTTP=8069
PORT_LONGPOLLING=8072

# Remote PostgreSQL Database Credentials
DB_HOST=remote-db-host.example.com
DB_PORT=5432
DB_USER=odoo_user
DB_PASSWORD=secret_db_password
DB_NAME=spark_erp_db

# Master Password for Database Management
ADMIN_PASSWORD=admin_super_secret_password

# Hugging Face Token (para descarga de modelos locales como google/embeddinggemma-2)
# HF_TOKEN=hf_your_token_here

