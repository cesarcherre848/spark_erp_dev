<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Lista (List) de Chunks y Embeddings por Página -->
    <record id="view_product_catalog_embedding_list" model="ir.ui.view">
        <field name="name">product.catalog.embedding.list</field>
        <field name="model">product.catalog.embedding</field>
        <field name="arch" type="xml">
            <list string="Chunks y Embeddings de Catálogos" create="false" edit="true" delete="true">
                <field name="catalog_id"/>
                <field name="partner_id"/>
                <field name="page_number" string="Pág."/>
                <field name="chunk_type"
                       widget="badge"
                       decoration-info="chunk_type == 'text'"
                       decoration-primary="chunk_type == 'image'"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="ai_provider" widget="badge" optional="hide"/>
                <field name="ai_model"/>
                <field name="dimension" string="Dim."/>
                <field name="word_count" string="Palabras" optional="show"/>
                <field name="embedded_image_count" string="Imgs." optional="show"/>
                <field name="page_image_url" string="URL Imagen API" optional="show"/>
                <field name="content_hash" optional="hide"/>
                <field name="write_date" string="Fecha Vectorización"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario (Form) de Chunk / Página Vectorizada -->
    <record id="view_product_catalog_embedding_form" model="ir.ui.view">
        <field name="name">product.catalog.embedding.form</field>
        <field name="model">product.catalog.embedding</field>
        <field name="arch" type="xml">
            <form string="Chunk y Embedding de Página de Catálogo">
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Referencia del Chunk"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" readonly="1"/>
                    </div>
                    <group>
                        <group string="Catálogo y Página">
                            <field name="catalog_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="page_number" readonly="1"/>
                            <field name="total_pages" readonly="1"/>
                            <field name="chunk_type"
                                   widget="badge"
                                   decoration-info="chunk_type == 'text'"
                                   decoration-primary="chunk_type == 'image'"
                                   readonly="1"/>
                            <field name="catalog_state"
                                   widget="badge"
                                   decoration-success="catalog_state == 'active'"
                                   decoration-info="catalog_state == 'upcoming'"
                                   decoration-danger="catalog_state == 'expired'"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Modelo de IA y Metadatos Vectoriales">
                            <field name="ai_provider" readonly="1"/>
                            <field name="ai_model" readonly="1"/>
                            <field name="dimension" readonly="1"/>
                            <field name="vector_preview" readonly="1"/>
                            <field name="content_hash" readonly="1"/>
                            <field name="page_image_url" widget="url" readonly="1"/>
                            <field name="write_date" string="Fecha Vectorización" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Imagen Capturada de la Página" name="page_image_tab">
                            <group>
                                <field name="page_image_filename" invisible="1"/>
                                <field name="page_image"
                                       widget="image"
                                       filename="page_image_filename"
                                       nolabel="1"
                                       readonly="1"/>
                            </group>
                        </page>
                        <page string="Texto Extraído de la Página" name="raw_text_tab">
                            <group col="4">
                                <field name="char_count" readonly="1"/>
                                <field name="word_count" readonly="1"/>
                                <field name="embedded_image_count" readonly="1"/>
                            </group>
                            <field name="raw_page_text" widget="text" readonly="1" placeholder="Sin texto extraído en esta página..."/>
                        </page>
                        <page string="Prompt Vectorizado (EmbeddingGemma-2)" name="source_text_tab">
                            <field name="source_text" widget="text" readonly="1"/>
                        </page>
                        <page string="Metadatos Estructurados (JSON)" name="metadata_json_tab">
                            <field name="metadata_json" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de Búsqueda y Filtros (Search) -->
    <record id="view_product_catalog_embedding_search" model="ir.ui.view">
        <field name="name">product.catalog.embedding.search</field>
        <field name="model">product.catalog.embedding</field>
        <field name="arch" type="xml">
            <search string="Buscar Chunks y Embeddings de Catálogos">
                <field name="name"/>
                <field name="catalog_id"/>
                <field name="partner_id"/>
                <field name="tag_ids"/>
                <field name="raw_page_text" string="Contenido de Página"/>
                <field name="ai_model"/>
                <separator/>
                <filter string="Chunks de Texto" name="type_text" domain="[('chunk_type', '=', 'text')]"/>
                <filter string="Chunks de Imagen" name="type_image" domain="[('chunk_type', '=', 'image')]"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Catálogo" name="group_catalog" context="{'group_by': 'catalog_id'}"/>
                    <filter string="Proveedor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="N° de Página" name="group_page" context="{'group_by': 'page_number'}"/>
                    <filter string="Modalidad" name="group_chunk_type" context="{'group_by': 'chunk_type'}"/>
                    <filter string="Modelo IA" name="group_model" context="{'group_by': 'ai_model'}"/>
                    <filter string="Dimensión" name="group_dimension" context="{'group_by': 'dimension'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_product_catalog_embedding" model="ir.actions.act_window">
        <field name="name">Embeddings por Página de Catálogo</field>
        <field name="res_model">product.catalog.embedding</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_product_catalog_embedding_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay páginas vectorizadas.
            </p>
            <p>
                Al subir un documento PDF en Catálogos de Proveedores, cada página se dividirá en chunks con su imagen capturada y su vector de embedding.
            </p>
        </field>
    </record>

</odoo>
